# Server Configuration
PORT=3000
HOST=0.0.0.0
API_SECRET_KEY=

# YouTube Client Spoofing (Options: ANDROID, TV_EMBEDDED, IOS, WEB)
# ANDROID & TV_EMBEDDED have the lowest IP ban and BotGuard challenge rates
YT_CLIENT_TYPE=ANDROID

# BotGuard / Anti-Bot Bypasses
# PO Token (Proof of Origin) & Visitor Data (Can be generated via bgUtils or fresh browser session)
YT_PO_TOKEN=
YT_VISITOR_DATA=

# YouTube Cookie (Paste raw cookies or Netscape cookie string)
# Leave empty if using Android client without login
YT_COOKIES=

# Rotating Proxies (Comma-separated list of HTTP, HTTPS, or SOCKS5 proxies)
# Example: http://user:pass@1.2.3.4:8080,socks5://5.6.7.8:1080
PROXIES=

# IPv6 Subnet Binding (If your VPS has a /64 IPv6 pool, e.g., 2001:db8:1234:5678::/64)
# Leave blank if not using IPv6 rotation
IPV6_SUBNET=

# Cache Settings (in seconds) - 4 hours default
CACHE_TTL_SECONDS=14400

# Fallback Settings (Enable JioSaavn / SoundCloud fallback if YouTube fails)
ENABLE_FALLBACK=true
